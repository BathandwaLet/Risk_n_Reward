@model Risk_n_Reward.Web.Models.Player

@{
    ViewData["Title"] = "Crash";
}

<h1>@ViewData["Title"]</h1>
<span class="info-badge">
    <img src="~/images/site-icons/wallet.png" class="info-img"/> @Model.WalletBalance VMali
    <a asp-controller="Crash" asp-action="Info"><img src="~/images/site-icons/information.png" class="info-img" alt="information"/></a>
</span>

@if (TempData["Win"] != null)
{
    bool win = (bool)TempData["Win"];
    decimal betAmount = decimal.Parse((string)TempData["BetAmount"]);
    decimal crashPoint = decimal.Parse((string)TempData["CrashPoint"]);
    decimal finalMultiplier = decimal.Parse((string)TempData["FinalMultiplier"]);
    decimal payout = betAmount * finalMultiplier;
    
    if (win)
    {
        <p>
            Congratulations
            You cashed out at @finalMultiplier x and won @payout VMali!
        </p>
    }
    else
    {
        <p>
            CRASH!!!
            You crashed at @crashPoint x.
        </p>        
    }
}


<form method="post" asp-action="Play">
    <label for="betAmount">Bet Amount:</label>
    <input type="number" name="betAmount" min="1.00" step="1.00"/>
    <button type="submit" name="">Start</button>
    <button type="submit" name="cashOut" value="true">Cash Out</button>
</form>