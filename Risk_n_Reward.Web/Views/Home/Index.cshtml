@model Risk_n_Reward.Web.Models.Player

@{
    ViewData["Title"] = "Home Page";
}
<section>
    <h1>Risk n Reward</h1>
    <h4>Ten games. All virtual</h4>
</section>

<div class="align-content-center" xmlns="http://www.w3.org/1999/html" xmlns="http://www.w3.org/1999/html">
    <section>
        <h3>Games</h3>
        <div class="home-icons-row">
            <div class="home-icons-inline">
                <a asp-controller="CoinToss" asp-action="Index" class="home-icons">
                    <img src="~/images/home-icons/coin-toss.png" alt="coin-toss"/>
                    <span>Coin Toss</span>
                </a>
            </div>

            <div class="home-icons-inline">
                <a asp-controller="" asp-action="" class="home-icons">
                    <img src="~/images/home-icons/poker.png" alt="texas-holdem"/>
                    <span>Texas Hold 'em</span>
                </a>
                
            </div>
        </div>

        <div class="home-icons-row">
            <div class="home-icons-inline">
                <a asp-controller="" asp-action="" class="home-icons">
                    <img src="~/images/home-icons/baccarat.png" alt="baccarat"/>
                    <span>Baccarat</span>
                </a>
            </div>

            <div class="home-icons-inline">
                <a asp-controller="Crash" asp-action="Index" class="home-icons">
                    <img src="~/images/home-icons/crash.png" alt="crash" />
                    <span>Crash</span>
                </a>
            </div>
        </div>

        <div class="home-icons-row">
            <div class="home-icons-inline">
                <a asp-controller="" asp-action="" class="home-icons">
                    <img src="~/images/home-icons/roulette.png" alt="roulette" />
                    <span>Roulette</span>
                </a>
            </div>

            <div class="home-icons-inline">
                <a asp-controller="" asp-action="" class="home-icons">
                    <img src="~/images/home-icons/blackjack.png" alt="blackjack" />
                    <span>Black Jack</span>
                </a>
                
            </div>
        </div>

        <div class="home-icons-row">
            <div class="home-icons-inline">
                <a asp-controller="Slots" asp-action="Index" class="home-icons">
                    <img src="~/images/home-icons/slots.png" alt="slots" />
                    <span>Slots</span>
                </a>
            </div>

            <div class="home-icons-inline">
                <a asp-controller="PickFive" asp-action="Index" class="home-icons">
                    <img src="~/images/home-icons/pick-five.png" />
                    <span>Pick Five</span>
                </a>
            </div>
        </div>

        <div class="home-icons-row">
            <div class="home-icons-inline">
                <a asp-controller="" asp-action="" class="home-icons">
                    <img src="~/images/home-icons/lucky-dice.png" />
                    <span>Lucky Dice</span>
                </a>
            </div>

            <div class="home-icons-inline">
                <a asp-controller="HighLow" asp-action="Index" class="home-icons">
                    <img src="~/images/home-icons/high-low.png" />
                    <span>High Low</span>
                </a>
            </div>
        </div>
    </section>
</div>