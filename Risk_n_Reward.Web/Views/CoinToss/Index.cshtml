@using Risk_n_Reward.Core.Core.Models.CoinTossModels.CoinSide
@model Risk_n_Reward.Web.Models.Player

@{
    ViewData["Title"] = "Coin Toss";
}

<h1>@ViewData["Title"]</h1>
<span class="info-badge">
    <img src="~/images/site-icons/wallet.png" class="info-img"/> @Model.WalletBalance VMali
    <a asp-controller="CoinToss" asp-action="Info"><img src="~/images/site-icons/information.png" class="info-img"/></a>
</span>

@if (TempData["Win"] != null)
{
    bool win = (bool)TempData["Win"];
    decimal payout = decimal.Parse((string)TempData["Payout"]);
    var playerChoice = TempData["Player"];
    var computerChoice = TempData["Computer"];
    
    if (win)
    {
        <p>
            You selected: @playerChoice <br/>
            The coin toss produced: @computerChoice 
        </p>
        
        <p>
            Congratulations @Model.Username
            You have won @payout VMali!
        </p>
    }
    else
    {
        <p>
            You selected: @playerChoice <br/>
            The coin toss produced: @computerChoice 
        </p>
        
        <p>
            Unfortunately
            You have lost.
        </p>        
    }
}

<form method="post" asp-action="Play">
    <label for="betAmount">Bet Amount:</label>
    <input type="number" id="betAmount" name="betAmount" min="10" step="0.1"/>
    <div>
        <button type="submit" name="coinSide" value="Heads" class="btn-coin-toss-icons">
            <img src="~/images/gameassets/cointoss/coin-toss-heads.png"/>
            <span>Heads</span>
        </button>
        <button type="submit" name="coinSide" value="Tails" class="btn-coin-toss-icons">
            <img src="~/images/gameassets/cointoss/coin-toss-tails.png"/>
            <span>Tails</span>
        </button>
    </div>
</form>