@model Risk_n_Reward.Web.Models.Player

@{
    ViewData["Title"] = "Coin Toss";
}

<h1>Coin Toss</h1>
<p>
    Balance: @Model.WalletBalance VMali
    @*WinStreak: @Model.WinStreaks Display the current winstreak*@
</p>

@if (TempData["Win"] != null)
{
    bool win = (bool)TempData["Win"];
    decimal betAmount = decimal.Parse((string)TempData["BetAmount"]);
    decimal payout = decimal.Parse((string)TempData["Payout"]);

    if (win)
    {
        <p>
            Congratulations
            You have won @payout VMali!
        </p>
    }
    else
    {
        <p>
            Unfortunately
            You have lost.
        </p>        
    }
}

<form method="post" asp-action="Play">
    <label for="betAmount">Bet Amount:</label>
    <input type="number" id="betAmount" name="betAmount" min="10" step="0.1"/>
    <button type="submit" name="coinSide" value="Heads">
        <img src="~/images/gameassets/cointoss/coin-toss-heads.png" />
        Heads
    </button>
    <button type="submit" name="coinSide" value="Tails">
        <img src="~/images/gameassets/cointoss/coin-toss-tails.png"/>
        Tails
    </button>
</form>